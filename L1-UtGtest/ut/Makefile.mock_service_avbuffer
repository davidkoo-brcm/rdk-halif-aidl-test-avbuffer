.PHONY: mock_service

HAL_DIR ?= $(CURDIR)

AVBUFFER_SONAME := avbufferaidl
AUDIODECODER_SONAME := audiodecoderaidl
VIDEODECODER_SONAME := videodecoderaidl

MOCK_SERVICE_BIN := AVBufferService
AVBUFFER_LIB := lib$(AVBUFFER_SONAME).so
AUDIODECODER_LIB := lib$(AUDIODECODER_SONAME).so
VIDEODECODER_LIB := lib$(VIDEODECODER_SONAME).so

MOCK_SERVICE_DIR ?= $(HAL_DIR)/avbuffer_mock/src/service

BUILD_DIR ?= $(HAL_DIR)/build

AIDL_GEN_DIR ?= $(BUILD_DIR)/avbuffer_gen

COMMON_GEN_SRC +=	${AIDL_GEN_DIR}/cpp/com/rdk/hal/AVSource.cpp
COMMON_GEN_SRC +=	${AIDL_GEN_DIR}/cpp/com/rdk/hal/HALError.cpp
COMMON_GEN_SRC +=	${AIDL_GEN_DIR}/cpp/com/rdk/hal/PropertyValue.cpp
COMMON_GEN_SRC +=	${AIDL_GEN_DIR}/cpp/com/rdk/hal/State.cpp

AVBUFFER_LIB_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/avbuffer/HeapMetrics.cpp
AVBUFFER_LIB_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/avbuffer/IAVBuffer.cpp
AVBUFFER_LIB_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/avbuffer/IAVBufferSpaceListener.cpp
AVBUFFER_LIB_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/avbuffer/Pool.cpp
AVBUFFER_LIB_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/avbuffer/PoolMetrics.cpp

AUDIODECODER_GEN_SRC +=	${AIDL_GEN_DIR}/cpp/com/rdk/hal/audiodecoder/Capabilities.cpp
AUDIODECODER_GEN_SRC +=	${AIDL_GEN_DIR}/cpp/com/rdk/hal/audiodecoder/ChannelType.cpp
AUDIODECODER_GEN_SRC +=	${AIDL_GEN_DIR}/cpp/com/rdk/hal/audiodecoder/Codec.cpp
AUDIODECODER_GEN_SRC +=	${AIDL_GEN_DIR}/cpp/com/rdk/hal/audiodecoder/CSDAudioFormat.cpp
AUDIODECODER_GEN_SRC +=	${AIDL_GEN_DIR}/cpp/com/rdk/hal/audiodecoder/ErrorCode.cpp
AUDIODECODER_GEN_SRC +=	${AIDL_GEN_DIR}/cpp/com/rdk/hal/audiodecoder/FrameMetadata.cpp
AUDIODECODER_GEN_SRC +=	${AIDL_GEN_DIR}/cpp/com/rdk/hal/audiodecoder/IAudioDecoderController.cpp
AUDIODECODER_GEN_SRC +=	${AIDL_GEN_DIR}/cpp/com/rdk/hal/audiodecoder/IAudioDecoderControllerListener.cpp
AUDIODECODER_GEN_SRC +=	${AIDL_GEN_DIR}/cpp/com/rdk/hal/audiodecoder/IAudioDecoder.cpp
AUDIODECODER_GEN_SRC +=	${AIDL_GEN_DIR}/cpp/com/rdk/hal/audiodecoder/IAudioDecoderEventListener.cpp
AUDIODECODER_GEN_SRC +=	${AIDL_GEN_DIR}/cpp/com/rdk/hal/audiodecoder/IAudioDecoderManager.cpp
AUDIODECODER_GEN_SRC +=	${AIDL_GEN_DIR}/cpp/com/rdk/hal/audiodecoder/PCMFormat.cpp
AUDIODECODER_GEN_SRC +=	${AIDL_GEN_DIR}/cpp/com/rdk/hal/audiodecoder/Property.cpp

VIDEODECODER_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/videodecoder/Capabilities.cpp
VIDEODECODER_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/videodecoder/FrameMetadata.cpp
VIDEODECODER_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/videodecoder/IVideoDecoder.cpp
VIDEODECODER_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/videodecoder/PropertyKVPair.cpp
VIDEODECODER_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/videodecoder/CodecCapabilities.cpp
VIDEODECODER_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/videodecoder/IVideoDecoderEventListener.cpp
VIDEODECODER_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/videodecoder/IVideoDecoderController.cpp
VIDEODECODER_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/videodecoder/IVideoDecoderControllerListener.cpp

MOCK_SERVICE_BIN_SRC := $(MOCK_SERVICE_DIR)/AVBufferService.cpp
MOCK_SERVICE_BIN_SRC += $(MOCK_SERVICE_DIR)/AVBuffer.cpp

MOCK_SERVICE_INC_FLAGS := -I$(AIDL_GEN_DIR)/h
MOCK_SERVICE_INC_FLAGS += -I$(BUILD_DIR)/usr/include 
MOCK_SERVICE_INC_FLAGS += -I$(MOCK_SERVICE_DIR)

MOCK_SERVICE_LD_LIBS := -lbinder -lutils

MOCK_SERVICE_LDFLAGS := -L$(BUILD_DIR)/usr/lib
MOCK_SERVICE_LDFLAGS += -Wl,-rpath-link=$(BUILD_DIR)/usr/lib


MOCK_SERVICE_CFLAGS := -Wall -Wextra -std=c++17 -ggdb

mock_service: $(MOCK_SERVICE_BIN) $(AVBUFFER_LIB) $(AUDIODECODER_LIB) $(VIDEODECODER_LIB)

$(AUDIODECODER_LIB): $(AUDIODECODER_GEN_SRC:%.cpp=%.o) $(COMMON_GEN_SRC:%.cpp=%.o)
	g++ -shared $(MOCK_SERVICE_LDFLAGS) $^ -o $@ $(MOCK_SERVICE_LD_LIBS)
	install $@ $(BUILD_DIR)/usr/lib

$(VIDEODECODER_LIB): $(VIDEODECODER_GEN_SRC:%.cpp=%.o) $(COMMON_GEN_SRC:%.cpp=%.o)
	g++ -shared $(MOCK_SERVICE_LDFLAGS) $^ -o $@ $(MOCK_SERVICE_LD_LIBS)
	install $@ $(BUILD_DIR)/usr/lib

$(AVBUFFER_LIB): $(AUDIODECODER_LIB) $(VIDEODECODER_LIB)
$(AVBUFFER_LIB): $(AVBUFFER_LIB_SRC:%.cpp=%.o) $(COMMON_GEN_SRC:%.cpp=%.o)
	g++ -shared $(MOCK_SERVICE_LDFLAGS) $(filter %.o, $^) -o $@ $(MOCK_SERVICE_LD_LIBS) \
		-l$(AUDIODECODER_SONAME) \
		-l$(VIDEODECODER_SONAME)
	install $(AVBUFFER_LIB) $(BUILD_DIR)/usr/lib

$(MOCK_SERVICE_BIN): $(AVBUFFER_LIB) $(AUDIODECODER_LIB) $(VIDEODECODER_LIB)
$(MOCK_SERVICE_BIN): $(MOCK_SERVICE_BIN_SRC:%.cpp=%.o)
	g++ $(MOCK_SERVICE_LDFLAGS) \
		$(MOCK_SERVICE_BIN_SRC:%.cpp=%.o) -o $@ \
		$(MOCK_SERVICE_LD_LIBS) \
		-lpthread \
		-l$(AVBUFFER_SONAME)
	install $(MOCK_SERVICE_BIN) $(BUILD_DIR)/usr/bin

%.o: %.cpp
	g++ $(MOCK_SERVICE_CFLAGS) $(MOCK_SERVICE_INC_FLAGS) -fPIC -c $< -o $@
